{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisZakharov2/autonomous-sw-factory/schemas/eval-expected.schema.json",
  "title": "EvalExpected",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "status": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$"},
      "uniqueItems": true
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"count": {"type": "integer", "minimum": 0}}
    },
    "gates_closed": {
      "type": "array",
      "items": {"type": "string", "pattern": "^gate_[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "submitters": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "product_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "min_tests": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    }
  }
}
