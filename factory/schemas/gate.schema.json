{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisZakharov2/autonomous-sw-factory/schemas/gate.schema.json",
  "title": "FactoryGateDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "stage", "status", "approver", "decided_by", "decided_at", "evidence", "attempts"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^gate_"},
    "stage": {"type": "string"},
    "status": {"type": "string", "enum": ["pending", "approved", "rejected", "needs_human"]},
    "approver": {"type": "string"},
    "decided_by": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "attempts": {"type": "integer", "minimum": 0}
  }
}
