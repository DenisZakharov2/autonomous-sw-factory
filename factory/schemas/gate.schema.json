{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisZakharov2/autonomous-sw-factory/schemas/gate.schema.json",
  "title": "FactoryGateRecord",
  "description": "One entry of state.gate_status. Must stay identical to state.schema.json $defs.gate; doctor enforces the parity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "approver", "decided_by", "decided_at", "evidence", "attempts"],
  "properties": {
    "status": {"type": "string", "enum": ["pending", "approved", "rejected", "needs_human"]},
    "approver": {"type": "string"},
    "decided_by": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "attempts": {"type": "integer", "minimum": 0}
  }
}
