{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisZakharov2/autonomous-sw-factory/schemas/pipeline.schema.json",
  "title": "FactoryPipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "modes", "stages"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roles", "budget"],
        "properties": {
          "description": {"type": "string"},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tokens", "minutes", "usd"],
            "properties": {
              "tokens": {"type": "integer", "minimum": 1},
              "minutes": {"type": "integer", "minimum": 1},
              "usd": {"type": "number", "minimum": 0}
            }
          },
          "stage_roles": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
          "artifact_owners": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "artifact_paths": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "entry", "exit", "roles", "artifacts", "gate", "max_attempts", "rework_to"],
        "properties": {
          "id": {"type": "string", "pattern": "^(s_in|s00_intake|s0_vision|s1_spec|s15_quarantine|s2_architecture|s3_plan|s4_build|s5_acceptance|s6_security|s7_release|s8_docs|s9_learn)$"},
          "order": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "entry": {"type": "array", "items": {"type": "string"}},
          "exit": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "parallel": {"type": "boolean"},
          "gate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "approver", "blocking", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^gate_"},
              "approver": {"type": "string", "minLength": 1},
              "blocking": {"type": "boolean"},
              "evidence": {"type": "array", "items": {"type": "string"}}
            }
          },
          "max_attempts": {"type": "integer", "minimum": 1},
          "rework_to": {"type": "string"}
        }
      }
    }
  }
}
