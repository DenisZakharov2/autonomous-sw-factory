{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisZakharov2/autonomous-sw-factory/schemas/state.schema.json",
  "title": "FactoryRunState",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "mode", "current_stage", "stage_status", "gate_status", "tasks", "veto_counters", "human_spec_approved", "restore_drill_passed", "last_event_hash", "event_count", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "mode": {"type": "string", "enum": ["nano", "standard", "enterprise", "brownfield"]},
    "current_stage": {"type": ["string", "null"]},
    "stage_status": {"type": "object", "additionalProperties": {"type": "string", "enum": ["pending", "in_progress", "review", "accepted", "blocked", "escalated"]}},
    "gate_status": {"type": "object", "additionalProperties": {"$ref": "#/$defs/gate"}},
    "tasks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/task"}},
    "veto_counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "human_spec_approved": {"type": "boolean"},
    "restore_drill_passed": {"type": "boolean"},
    "last_event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_count": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "stage", "owner", "reqs", "allowed_files", "deps", "status", "attempts", "artifacts", "lease"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
        "stage": {"type": "string"},
        "owner": {"type": "string"},
        "reqs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"}},
        "allowed_files": {"type": "array", "items": {"type": "string"}},
        "deps": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["pending", "in_progress", "blocked", "review", "accepted", "escalated"]},
        "attempts": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "lease": {"type": ["string", "null"]},
        "reject_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approver", "decided_by", "decided_at", "evidence", "attempts"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "rejected", "needs_human"]},
        "approver": {"type": "string"},
        "decided_by": {"type": ["string", "null"]},
        "decided_at": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "attempts": {"type": "integer", "minimum": 0}
      }
    }
  }
}
